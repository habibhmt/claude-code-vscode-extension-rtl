{
  "name": "@local/dsh-nav",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ردیفِ سرصفحهٔ چت: سوئیچرِ پوشه و چت در همان ردیفِ نامِ چت (مثلِ منوی ساب‌ایجنت‌ها)",
  "scripts": {
    "test": "node --test test/*.mjs"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./pure": "./nav-pure.js"
  },
  "files": [
    "index.js",
    "client.js",
    "nav-pure.js",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  }
}
