{
  "name": "@local/dsh-rtl",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "description": "Right-to-left Persian typography and a three-level (global/project/chat) settings page for the DSH Web UI",
  "scripts": {
    "test": "node --test test/*.mjs",
    "sync": "node tools/sync-plus.mjs",
    "sync:check": "node tools/sync-plus.mjs --check"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "plus-pure.js",
    "tik-pure.js",
    "settings-pure.js",
    "tools",
    "aa-shared.cjs",
    "tool-help.cjs"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
