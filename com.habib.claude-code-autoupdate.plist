<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.habib.claude-code-autoupdate</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/habib/1-MY-WORK/136th-day-fix-rtl-claude/auto-update-claude-code.sh</string>
    </array>

    <!-- Agents load at login, so this covers a machine restart too. The run
         exits quietly when the network is not up yet; StartInterval retries. -->
    <key>RunAtLoad</key>
    <true/>

    <key>StartInterval</key>
    <integer>21600</integer>

    <key>StandardOutPath</key>
    <string>/Users/habib/1-MY-WORK/136th-day-fix-rtl-claude/autoupdate.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/habib/1-MY-WORK/136th-day-fix-rtl-claude/autoupdate.log</string>

    <key>ProcessType</key>
    <string>Background</string>

    <key>LowPriorityIO</key>
    <true/>
</dict>
</plist>
