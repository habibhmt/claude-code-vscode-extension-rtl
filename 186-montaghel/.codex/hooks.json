{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "/opt/homebrew/bin/python3 -I \"$HOME/1-MY-WORK/210th-day-flowchart/akharin_harekat.py\"",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/opt/homebrew/bin/python3 -I \"$HOME/1-MY-WORK/210th-day-flowchart/payam_hook.py\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
